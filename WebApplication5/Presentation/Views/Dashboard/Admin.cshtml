@{
    int count = ViewBag.tStd;
    List<Records>list = ViewBag.list;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
      <div class="row">
    <div class="col-sm-2">
        <nav class="bg-white min-vh-100">
            <div class="container-fluid">

                <div class="accordion" id="accordionExample">
                    <div class="accordion-item border-0 mb-2">

                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed  text-dark"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#demo1">
                                Student
                            </button>
                        </h2>

                        <div id="demo1"
                             class="accordion-collapse collapse"
                             data-bs-parent="#accordionExample">

                            <div class="p-3">
                                <a class="text-dark text-decoration-none d-block mb-2"
                                   asp-controller="Student"
                                   asp-action="Add">
                                    Add Student
                                </a>

                                <a class="text-dark text-decoration-none d-block"
                                   asp-controller="Student"
                                   asp-action="ViewStudents">
                                    View Student
                                </a>
                            </div>

                        </div>
                    </div>
                    <!-- Faculty -->
                    <div class="accordion-item  border-0 mb-2">

                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed  text-dark"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#demo2">
                                Faculty
                            </button>
                        </h2>

                        <div id="demo2"
                             class="accordion-collapse collapse"
                             data-bs-parent="#accordionExample">

                            <div class="p-3">
                                <a class="text-dark text-decoration-none d-block mb-2"
                                   asp-controller="Faculty"
                                   asp-action="Add">
                                    Add Faculty
                                </a>

                                <a class="text-dark text-decoration-none d-block"
                                   asp-controller="Faculty"
                                   asp-action="ViewFaculty">
                                    View Faculty
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- Class -->
                    <div class="accordion-item  border-0 mb-2">

                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed text-dark"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#demo3">
                                Class
                            </button>
                        </h2>

                        <div id="demo3"
                             class="accordion-collapse collapse"
                             data-bs-parent="#accordionExample">

                            <div class="p-3">
                                <a class="text-dark text-decoration-none d-block mb-2"
                                   asp-controller="Class"
                                   asp-action="Add">
                                    Add Class
                                </a>

                                <a class="text-dark text-decoration-none d-block"
                                   asp-controller="Class"
                                   asp-action="ViewClass">
                                    View Class
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- Attendance -->
                    <div class="accordion-item  border-0 mb-2">

                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-white text-dark"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#demo4">
                                Attendance
                            </button>
                        </h2>

                        <div id="demo4"
                             class="accordion-collapse collapse"
                             data-bs-parent="#accordionExample">

                            <div class="p-3">
                                <a class="text-dark text-decoration-none d-block"
                                   asp-controller="Attendence"
                                   asp-action="Show">
                                    Show Attendance
                                </a>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </nav>

    </div>
      <div class="col-9 ms-auto">
              <div class="d-flex flex-wrap  height:200px">
                    <div class="border bg-success p-4 mt-5 ms-2" style="width:200px ">
                         <div class="d-flex flex-column mt-1 text-white">
                          <p>👨🏻‍🎓</p>
                          <p><b>Total Students:</b></p><p>@ViewBag.tStd</p> </div>
                    </div>
                    @foreach(Records r in list){
                      <div class="border bg-danger p-4 mt-5 ms-2" style="width:200px ">
                         <div class="d-flex flex-column mt-1 text-white">
                          <p>📔</p>
                          <p><b>@r.className</b></p><p><b>Present:</b> @r.present</p> <p><b>Absent: </b>@r.absent</p><p><b>Late:</b> @r.late</p></div>
                    </div>
                    }
                        </div>
                        </div>
                        </div>
</body>
</html>