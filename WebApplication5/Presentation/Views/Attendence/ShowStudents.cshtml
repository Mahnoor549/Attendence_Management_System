@{
    var list = ViewBag.list as List<DAL.Models.TeacherClass>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
